# NVIDIA NIM Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PRIMARY_MODEL=openai/gpt-oss-20b
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MAX_OUTPUT_TOKENS=2048
NVIDIA_TEMPERATURE=0.1

# Security Secrets (64 hex characters for 32-byte key)
APP_SECRET=your_32_byte_secret_hex
TOKEN_ENCRYPTION_KEY=your_64_hex_chars_aes_256_key

# Database
DATABASE_URL="file:./dev.db"

# Server URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
