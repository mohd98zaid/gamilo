# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NVIDIA NIM Configuration (required for AI generation)
NVIDIA_API_KEY=replace_me
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PRIMARY_MODEL=openai/gpt-oss-20b
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MAX_OUTPUT_TOKENS=2048
NVIDIA_TEMPERATURE=0.1

# Security secrets. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace_with_64_hex_characters
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_characters

# Session settings
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Database. SQLite is for local development only; use PostgreSQL in production.
DATABASE_URL="file:./dev.db"

# Gmail OAuth (required for real Gmail connection; never use app passwords in production)
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
